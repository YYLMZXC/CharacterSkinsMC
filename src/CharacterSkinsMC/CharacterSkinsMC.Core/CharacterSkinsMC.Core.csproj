<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- 纯托管跨平台核心：桌面与 Android 共用；禁止引用 System.Drawing / WinForms。
		     PNG 编解码由 StbImageSharp / StbImageWriteSharp 承担。 -->
		<TargetFramework>$(GlobalTargetFramework)</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<AssemblyName>CharacterSkinsMC.Core</AssemblyName>
		<RootNamespace>CharacterSkinsMC.Core</RootNamespace>
		<IsPackable>false</IsPackable>
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="StbImageSharp" Version="2.30.15" />
		<PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
	</ItemGroup>
</Project>
