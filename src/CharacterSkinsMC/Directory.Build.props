<Project>
	<!-- 本目录是独立的皮肤转换工具仓库，两个工程不参与主仓 SCNETWORK.slnx。
	     原先工程里的 $(WindowsTargetFramework) 取自主仓根属性层；独立检出时该属性为空，
	     构建以 NETSDK1241（目标框架为空）中止。故以就近属性层自定身份并切断继承：
	     MSBuild 向上查找 Directory.Build.props 只命中最深一份，主仓根那份不再生效；
	     ImportDirectoryBuildTargets=false 再切断主仓根的打包、图集与构建契约目标，
	     使工具在「放在主仓 tools 下」与「独立检出」两种布局下取到同一套属性。 -->
	<PropertyGroup>
		<!-- 与主仓根 Directory.Build.props 的 GlobalTargetFramework 同口径；改基版本时两处同步。 -->
		<GlobalTargetFramework>net11.0</GlobalTargetFramework>
		<WindowsTargetFramework>$(GlobalTargetFramework)-windows</WindowsTargetFramework>
		<!-- Avalonia 双目标：桌面 + Android 单项目模式。 -->
		<AndroidTargetFramework>$(GlobalTargetFramework)-android</AndroidTargetFramework>
		<ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
	</PropertyGroup>
	<PropertyGroup>
		<!-- 版本号按构建时间自动生成：yy.MM.dd-HHmm（如 26.11.06-1421），每次构建刷新；
		     仅写 Version/InformationalVersion 供「关于」弹窗读取；
		     FileVersion 用数值型 yy.MM.dd.HHmm，AssemblyVersion 固定 1.0.0.0（数值限制）；
		     关闭 SDK 往 InformationalVersion 追加 Git 提交哈希的行为。 -->
		<BuildTimeVersion>$([System.DateTime]::Now.ToString('yy.MM.dd-HHmm'))</BuildTimeVersion>
		<Version>$(BuildTimeVersion)</Version>
		<InformationalVersion>$(BuildTimeVersion)</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<FileVersion>$([System.DateTime]::Now.ToString('yy.MM.dd.HHmm'))</FileVersion>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
	</PropertyGroup>
	<!-- RID 复位须在还原阶段生效（桌面 win-x64 经 NuGet dgspec 泄漏进移动 TFM 会触发 XA0035），
	     故在 props 末段显式导入本仓 targets，切断主仓的同时保住复位逻辑。 -->
	<Import Project="$(MSBuildThisFileDirectory)Directory.Build.targets" />
</Project>
