<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CharacterSkinsMC.App.AboutWindow"
        Title="关于 CharacterSkinsMC"
        Width="540" Height="320" CanResize="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height">
	<Window.Styles>
		<!-- 平台卡片：悬停时高亮底色，鼠标指针在 XAML 里声明为手型。 -->
		<Style Selector="Border.platformLink">
			<Setter Property="Background" Value="#FFF2F4F8" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="10,7" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style Selector="Border.platformLink:pointerover">
			<Setter Property="Background" Value="#FFE4EAF4" />
		</Style>
	</Window.Styles>
	<StackPanel Margin="16" Spacing="8">
		<TextBlock Text="CharacterSkinsMC" FontSize="22" FontWeight="Bold" />
		<TextBlock x:Name="VersionText" FontSize="14" Foreground="#FF505864" />
		<TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
		           Text="Minecraft 皮肤 → Survivalcraft（生存战争）皮肤转换工具。&#x0a;&#x0a;· 读取 64×64 Minecraft 皮肤（Classic / Slim 手臂，含第二层）&#x0a;· 转换为 Survivalcraft .scskin 图集，可直接放入游戏输入目录&#x0a;· 提供单张预览（MC 皮肤 / SC 图集 / 3D 模型）与批量转换" />
		<TextBlock TextWrapping="Wrap" Foreground="#FF9098A4"
		           Text="版本号按构建时间自动生成，格式为 年.月.日-时分（如 26.11.06-1421）。" />
		<TextBlock Text="代码托管平台（点击卡片打开）" FontWeight="Bold" Margin="0,8,0,2" />
		<ItemsControl x:Name="PlatformLinks" x:CompileBindings="False">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border Classes="platformLink" Margin="0,0,0,4"
					        PointerPressed="OnPlatformLinkPressed" ToolTip.Tip="点击在浏览器中打开">
						<!-- 平台名与地址各占一行，地址自动换行，任意 DPI 缩放下都不会被截断。 -->
						<StackPanel Spacing="1">
							<TextBlock Text="{Binding Platform}" FontWeight="Bold" />
							<TextBlock Text="{Binding Url}" Foreground="#FF2060A0"
							           TextDecorations="Underline" TextWrapping="Wrap" />
						</StackPanel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<Button Content="确定" Click="OnCloseClick" HorizontalAlignment="Right" Margin="0,8,0,0" />
	</StackPanel>
</Window>
