<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- 桌面 + Android 双目标：Android 走 .NET Android 单项目模式，入口在 Platforms/Android。 -->
		<TargetFrameworks>$(GlobalTargetFramework);$(AndroidTargetFramework)</TargetFrameworks>
		<OutputType Condition="'$(TargetFramework)' == '$(GlobalTargetFramework)'">WinExe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<AssemblyName>CharacterSkinsMC</AssemblyName>
		<RootNamespace>CharacterSkinsMC.App</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == '$(GlobalTargetFramework)'">
		<!-- Windows exe 图标；Avalonia 12 的 AvaloniaIncludeApplicationIconAsWindowIcon 默认开启，
		     同一 ico 会自动嵌入并作为所有 Window（主窗口/关于窗口）的默认图标。 -->
		<ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
		<OutputType>Exe</OutputType>
		<AndroidApplication>true</AndroidApplication>
		<!-- androidx.lifecycle 系列要求 minSdk ≥ 24（.NET 11 Android SDK 下限，旧 23 报 XA4216）。 -->
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<ApplicationId>com.sc.characterskinsmc</ApplicationId>
		<!-- Android 系统层显示名（启动器 / 应用信息），与应用内标题统一。 -->
		<ApplicationTitle>MC皮肤转SC</ApplicationTitle>
		<!-- Android 设置页展示的版本名取构建时间版本号（Directory.Build.props 生成的 yy.MM.dd-HHmm）。 -->
		<AndroidVersionName>$(Version)</AndroidVersionName>
		<AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>
		<!-- 发布配置：versionCode 按构建时间递增（yyMMddHH，10 位数值），可在命令行 -p: 覆盖。 -->
		<ApplicationVersion Condition="'$(ApplicationVersion)' == ''">$([System.DateTime]::Now.ToString('yyMMddHH'))</ApplicationVersion>
		<!-- dotnet publish 默认 Release 产出 .aab；固定为可直接安装的 .apk。
		     RID 集合由 Directory.Build.targets 复位为 android-arm64;android-x64，
		     publish 产出包含双 ABI 的通用 APK（-Signed 后缀为已用 debug 密钥签名的成品）。 -->
		<AndroidPackageFormat Condition="'$(AndroidPackageFormat)' == ''">apk</AndroidPackageFormat>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.5" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.5" Condition="'$(TargetFramework)' == '$(GlobalTargetFramework)'" />
		<PackageReference Include="Avalonia.Android" Version="12.1.5" Condition="$(TargetFramework.Contains('-android'))" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\CharacterSkinsMC.Core\CharacterSkinsMC.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- Android 平台代码与桌面 Program 入口按 TFM 隔离编译。 -->
		<Compile Remove="Platforms/Android/**/*.cs" />
		<Compile Include="Platforms/Android/**/*.cs" Condition="$(TargetFramework.Contains('-android'))" />
		<Compile Remove="Program.cs" Condition="$(TargetFramework.Contains('-android'))" />
	</ItemGroup>
</Project>
